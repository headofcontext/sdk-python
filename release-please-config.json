{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "skip-changelog": true,
  "packages": {
    ".": {
      "package-name": "headofcontext-client",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "src/headofcontext_client/__init__.py"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='headofcontext-client')].version"
        }
      ]
    }
  }
}
